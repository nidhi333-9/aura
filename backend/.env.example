# Local development settings for the backend.
#
#   cp backend/.env.example backend/.env.local
#
# .env.local overrides backend/.env (see config/env.js). On a developer machine .env often
# holds the PRODUCTION database and secrets, so keep your local values here instead: both files
# are git-ignored. Real environment variables (what Render provides) win over both.

# A database on your own machine, never the production one.
MONGO_URI=mongodb://localhost:27017/aura

# Only signs tokens on your machine. Any long random string; do NOT reuse the production one.
JWT_SECRET=local-dev-only-change-me

# Must match ml-service's value. Leave it out and analytics simply uses the database fallback.
ML_SHARED_SECRET=local-dev-ml-secret
