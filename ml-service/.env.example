# Local development settings for the ML service.
#
#   cp ml-service/.env.example ml-service/.env.local
#
# .env.local overrides ml-service/.env, which on a developer machine often holds the PRODUCTION
# database. Both files are git-ignored. Real environment variables win over both.

# A database on your own machine (the ML service only ever reads from it).
MONGO_URI=mongodb://localhost:27017/aura

# Must match the backend's value; requests without it are rejected.
ML_SHARED_SECRET=local-dev-ml-secret
