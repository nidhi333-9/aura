# Local development settings for the frontend.
#
#   cp frontend/.env.example frontend/.env.local
#
# Vite loads .env.local over .env on its own. .env here usually points at the LIVE backend, so
# without this file the dev server (and Google login) talks to production.

# The backend you are running locally (npm start in backend/ listens on 8080).
VITE_API_URL=http://localhost:8080
